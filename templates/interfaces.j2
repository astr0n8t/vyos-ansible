{% endif %}
{% if peer['allowed_ips'] is defined %}
{% for ip in peer['allowed_ips'] %}
set interfaces wireguard {{ interface['name'] }} peer {{ peer['name'] }} allowed-ips '{{ ip }}'
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
